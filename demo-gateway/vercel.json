{
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "https://nut-contracts-government-renew.trycloudflare.com/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
