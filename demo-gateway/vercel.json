{
  "rewrites": [
    {
      "source": "/",
      "destination": "https://gnome-pioneer-pts-flu.trycloudflare.com/"
    },
    {
      "source": "/:path*",
      "destination": "https://gnome-pioneer-pts-flu.trycloudflare.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
